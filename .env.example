# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# AlphaTrader Advisor Layer (OpenAI-compatible LLM endpoint, e.g. AIHubMix + Finnhub news)
# Configure these in the AI Studio Secrets panel.
LLM_BASE_URL=https://aihubmix.com/v1
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_MODEL=YOUR_LLM_MODEL
FINNHUB_KEY=YOUR_FINNHUB_KEY

# ModelRadar & AI Council multi-provider keys (optional; OpenRouter /models catalog is public)
AIHUBMIX_API_KEY=YOUR_AIHUBMIX_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
COUNCIL_MODELS=YOUR_COUNCIL_MODELS

